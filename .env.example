# Sao chép file này thành .env (cùng thư mục với app.py) rồi điền giá trị thật. KHÔNG chia sẻ/commit file .env.

# --- Giá thị trường (DNSE) ---
DNSE_API_KEY=
DNSE_API_SECRET=

# --- Gửi báo cáo PDF qua email ---
# Gmail/Outlook/Yahoo: chỉ cần 2 dòng dưới (host và cổng tự nhận từ địa chỉ email).
STOCKLENS_SMTP_USERNAME=ten.cua.ban@gmail.com
# Gmail: bật Xác minh 2 bước, tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords và dán vào đây
STOCKLENS_SMTP_PASSWORD=abcdefghijklmnop

# Tuỳ chọn (chỉ cần khi dùng máy chủ khác):
# STOCKLENS_SMTP_HOST=smtp.example.com
# STOCKLENS_SMTP_PORT=587
# STOCKLENS_SMTP_FROM=ten.cua.ban@example.com
# STOCKLENS_SMTP_STARTTLS=true
# STOCKLENS_SMTP_SSL=false
